NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=mysql://wasaas:wasaas@localhost:3306/wasaas
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_STEPUP_SECRET=change-me-stepup-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 32-byte key, base64. Generate with: openssl rand -base64 32
SECRETS_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SECRETS_KEY_VERSION=1

S3_BUCKET=wasaas-media
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Connectors: "browser" = WhatsApp Web via Puppeteer (browser-worker process).
# "sandbox" simulates QR linking + delivery for dev/staging and is refused in production.
ENABLED_CONNECTORS=browser,sandbox

# Browser worker (WhatsApp Web sessions)
BROWSER_DATA_DIR=./.sessions          # production: encrypted volume, mode 0700, shared only between browser workers
BROWSER_EXECUTABLE_PATH=              # e.g. /usr/bin/chromium in the Docker image
BROWSER_MAX_SESSIONS=10               # linked numbers per browser-worker instance
BROWSER_MIN_INTERVAL_MS=4000          # pacing between sends on one number
BROWSER_DAILY_LIMIT=1000              # per number per day; campaign pauses when reached
BROWSER_SEND_TIMEOUT_MS=90000         # after this the outcome is recorded as Unknown
BROWSER_QR_MAX_RETRIES=5              # QR rotations (~20s each) before linking expires
BROWSER_ARGS=--disable-dev-shm-usage

# Billing (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=

# Email (password reset, invitations, sign-in codes). Any SMTP provider: SES, Postmark, SendGrid…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Relay <no-reply@example.com>

# Monitoring: API serves /metrics with "Authorization: Bearer $METRICS_TOKEN"; workers listen on METRICS_PORT.
METRICS_TOKEN=
METRICS_PORT=
LOG_FORMAT=json                       # json lines with secrets redacted (default in production)

# Optional upload malware scanning via clamd
CLAMAV_HOST=
CLAMAV_PORT=3310

# Retention (days)
RETENTION_DELETED_TENANT_DAYS=30
RETENTION_MESSAGE_CONTENT_DAYS=90
RETENTION_MESSAGE_EVENT_DAYS=400
RETENTION_AUDIT_DAYS=730
